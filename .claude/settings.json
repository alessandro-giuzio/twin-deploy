{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(./check.sh)",
      "Bash(npm run build)",
      "Bash(git commit *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(netlify deploy *)",
      "Bash(npx netlify deploy *)",
      "Bash(wrangler deploy *)",
      "Bash(npx wrangler deploy *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  }
}
